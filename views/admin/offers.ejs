<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="main-content">

    <h2>Manage Offers</h2>

    <!-- ADD OFFER -->
    <div class="card mb-4">
      <div class="card-body">
        <h5>Add New Offer</h5>

        <form method="POST" action="/admin/offers/add">
          <div class="row g-2">

            <div class="col">
              <input type="text" name="name" class="form-control" placeholder="Offer Name" required>
            </div>

            <div class="col">
              <input type="number" name="payout" class="form-control" placeholder="Payout" required>
            </div>

            <div class="col">
              <input type="text" name="category" class="form-control" placeholder="Category">
            </div>

            <div class="col">
              <select name="model" class="form-select">
                <option value="CPA">CPA</option>
                <option value="CPL">CPL</option>
                <option value="CPC">CPC</option>
              </select>
            </div>

            <div class="col">
              <select name="status" class="form-select">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
              </select>
            </div>

            <div class="col-12 mt-2">
              <input type="text" name="client_url" class="form-control"
                placeholder="http://localhost:3000/advertiser-page?click_id={click_id}&pub_id={pub_id}&source={source}">
            </div>

            <div class="col-12 mt-2">
              <button class="btn btn-primary">Add</button>
            </div>

          </div>
        </form>
      </div>
    </div>

    <!-- OFFERS TABLE -->
    <div class="card">
      <div class="card-body">

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Payout</th>
              <th>Client URL</th>
              <th>Category</th>
              <th>Model</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% offers.forEach(o => { %>
              <tr>
                <td><%= o.id %></td>
                <td><%= o.name %></td>
                <td>₹<%= o.payout %></td>
                <td><%= o.client_url || 'Not set' %></td>
                <td><%= o.category %></td>
                <td><%= o.model %></td>
                <td><%= o.status %></td>
                <td>
                  <a href="/admin/offers/edit/<%= o.id %>" class="btn btn-warning btn-sm">Edit</a>
                  <a href="/admin/offers/delete/<%= o.id %>" class="btn btn-danger btn-sm">Delete</a>
                </td>
              </tr>
            <% }) %>
          </tbody>

        </table>

      </div>
    </div>

  </div>
</div>

</body>
</html>